# Use absolute host paths. Do not commit a populated copy of this file.
TLS_CERT_FILE=
TLS_KEY_FILE=
STATIC_ROOT=

HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=local
NGINX_IMAGE=nginx:alpine

# Behavior pipeline ClickHouse DSN. Compose defaults: middleware
# http://clickhouse:8123/xbh_analytics, production clickhouse://clickhouse:9000/xbh_analytics.
CLICKHOUSE_DSN=

# Optional proxy for image builds (empty when no proxy is used).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Middleware administrator credentials.
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MILVUS_MINIO_ROOT_USER=
MILVUS_MINIO_ROOT_PASSWORD=
GRAFANA_PASSWORD=

# Application credentials and per-database MySQL DSNs.
JWT_SECRET_KEY=
# 刷新令牌独立签名密钥（user rpc 签发 refresh token）
JWT_REFRESH_SECRET=
# 服务间 gRPC 内部鉴权共享密钥（HMAC-SHA256），全服务一致
RPC_INTERNAL_SECRET=
DB_USER=
DB_CONTENT=
DB_MEDIA=
DB_INTERACTION=
DB_FEED=
DB_MESSAGE=
DB_ASSISTANT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
FEED_CURSOR_SECRET=
RECOMMEND_CURSOR_SECRET=

# Registered recommendation model loaded by production OnlineInfer.
MODEL_REGISTRY_MANIFEST_URI=
MODEL_REGISTRY_VERSION=
MODEL_S3_ENDPOINT=http://minio:9000
MODEL_S3_REGION=us-east-1
MODEL_REGISTRY_BUCKET=xbh-models
MODEL_REGISTRY_PREFIX=recommend-models
MODEL_TRAIN_VERSION=
MODEL_FEATURE_START=
MODEL_SAMPLE_START=
MODEL_SAMPLE_END=
MODEL_FEATURE_VERSION=v2
MODEL_REGISTRY_STATUS=candidate
MODEL_VALIDATION_FRACTION=0.2

# Optional protected Elasticsearch, Milvus, and LLM settings.
ES_USERNAME=
ES_PASSWORD=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
ASSISTANT_AGENT_ENABLED=false
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_WIRE_API=responses
ASSISTANT_LLM_ENDPOINT=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_MODEL_SMALL=
ASSISTANT_LLM_REVIEW_MODEL=
TAVILY_API_KEY=
ASSISTANT_LLM_PROMPT_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_COMPLETION_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_CACHE_READ_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_CACHE_WRITE_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_REASONING_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_FALLBACK_ENABLED=false
ASSISTANT_LLM_FALLBACK_ROUTE_ID=fallback
ASSISTANT_LLM_FALLBACK_BOUNDARY=default
ASSISTANT_LLM_FALLBACK_WIRE_API=responses
ASSISTANT_LLM_FALLBACK_ENDPOINT=
ASSISTANT_LLM_FALLBACK_API_KEY=
ASSISTANT_LLM_FALLBACK_MODEL=
ASSISTANT_LLM_FALLBACK_PROMPT_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_FALLBACK_COMPLETION_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_FALLBACK_CACHE_READ_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_FALLBACK_CACHE_WRITE_COST_PER_MILLION_TOKENS=0
ASSISTANT_LLM_FALLBACK_REASONING_COST_PER_MILLION_TOKENS=0
