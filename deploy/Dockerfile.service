# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.1

FROM golang:${GO_VERSION}-alpine AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /src
COPY . .

ARG SERVICE_PATH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    test -n "${SERVICE_PATH}" && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/xbh-service "./${SERVICE_PATH}"

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 xbh && \
    adduser -S -D -H -u 10001 -G xbh xbh

ARG SERVICE_CONFIG
COPY --from=builder /out/xbh-service /usr/local/bin/xbh-service
COPY ${SERVICE_CONFIG} /etc/xbh/source.yaml
COPY deploy/service-entrypoint.sh /usr/local/bin/xbh-entrypoint

RUN chmod 0555 /usr/local/bin/xbh-service /usr/local/bin/xbh-entrypoint && \
    chmod 0444 /etc/xbh/source.yaml

USER xbh
ENTRYPOINT ["/usr/local/bin/xbh-entrypoint"]
