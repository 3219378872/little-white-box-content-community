syntax = "v1"

info (
	title:   "小白盒内容社区 Gateway API"
	desc:    "小白盒内容社区网关服务"
	author:  "xbh"
	version: "1.0.0"
)

// ============================================
// 用户相关类型
// ============================================
type (
	RegisterReq {
		Username   string `json:"username"`
		Password   string `json:"password"`
		Phone      string `json:"phone,optional"`
		VerifyCode string `json:"verifyCode,optional"`
	}
	RegisterResp {
		UserId       int64  `json:"userId"`
		Token        string `json:"token"`
		RefreshToken string `json:"refreshToken,optional"`
	}
)

type (
	RefreshTokenReq {
		RefreshToken string `json:"refreshToken"`
	}
	RefreshTokenResp {
		Token        string `json:"token"`
		RefreshToken string `json:"refreshToken"`
	}
)

type (
	LoginReq {
		Username   string `json:"username,optional"`
		Password   string `json:"password,optional"`
		Phone      string `json:"phone,optional"`
		VerifyCode string `json:"verifyCode,optional"`
		LoginType  int32  `json:"loginType"` // 1:密码登录 2:验证码登录
	}
	LoginResp {
		UserId       int64  `json:"userId"`
		Token        string `json:"token"`
		RefreshToken string `json:"refreshToken,optional"`
	}
)

type (
	SendVerifyCodeReq {
		Phone string `json:"phone"`
		Type  int32  `json:"type"` // 1:注册 2:登录 3:重置密码
	}
	SendVerifyCodeResp  {}
)

type (
	GetUserReq {
		UserId int64 `path:"userId"`
	}
	GetUserResp {
		Id               int64  `json:"id"`
		Username         string `json:"username"`
		Nickname         string `json:"nickname"`
		AvatarUrl        string `json:"avatarUrl"`
		Bio              string `json:"bio"`
		Level            int32  `json:"level"`
		FollowerCount    int64  `json:"followerCount"`
		FollowingCount   int64  `json:"followingCount"`
		PostCount        int64  `json:"postCount"`
		FavoritesVisible bool   `json:"favoritesVisible"`
	}
)

type (
	UpdateProfileReq {
		Nickname  string `json:"nickname,optional"`
		AvatarUrl string `json:"avatarUrl,optional"`
		Bio       string `json:"bio,optional"`
	}
	UpdateProfileResp  {}
)

type (
	GetUserPostsReq {
		UserId   int64  `path:"userId"`
		PageSize int32  `form:"pageSize,default=20"`
		SortBy   int32  `form:"sortBy,optional,default=1"`
		Cursor   string `form:"cursor,optional"` // 不透明游标；首页传空
	}
)

type (
	GetUserFavoritesReq {
		UserId   int64  `path:"userId"`
		Page     int32  `form:"page,default=1"`
		PageSize int32  `form:"pageSize,default=20"`
		Cursor   string `form:"cursor,optional"` // 统一游标形状；内部换算页码
	}
)

// ============================================
// 帖子相关类型
// ============================================
type (
	CreatePostReq {
		Title          string   `json:"title"`
		Content        string   `json:"content"`
		Images         []string `json:"images,optional"`
		Tags           []string `json:"tags,optional"`
		Status         int32    `json:"status,optional"` // 0:草稿 1:发布
		IdempotencyKey string   `json:"idempotencyKey,optional"`
		MediaIds       []int64  `json:"mediaIds,optional"`
	}
	CreatePostResp {
		PostId   int64 `json:"postId"`
		Status   int32 `json:"status"`
		Revision int64 `json:"revision"`
	}
)

type (
	GetPostReq {
		PostId int64 `path:"postId"`
	}
	GetPostResp {
		Id            int64    `json:"id"`
		AuthorId      int64    `json:"authorId"`
		AuthorName    string   `json:"authorName"`
		AuthorAvatar  string   `json:"authorAvatar"`
		Title         string   `json:"title"`
		Content       string   `json:"content"`
		Images        []string `json:"images"`
		Tags          []string `json:"tags"`
		Status        int32    `json:"status"`
		ViewCount     int64    `json:"viewCount"`
		LikeCount     int64    `json:"likeCount"`
		CommentCount  int64    `json:"commentCount"`
		FavoriteCount int64    `json:"favoriteCount"`
		IsLiked       bool     `json:"isLiked"`
		IsFavorited   bool     `json:"isFavorited"`
		Revision      int64    `json:"revision"`
		CreatedAt     int64    `json:"createdAt"`
	}
)

type (
	UpdatePostResp {
		Status   int32 `json:"status"`
		Revision int64 `json:"revision"`
	}
	DeletePostResp  {}
)

// v2 写接口类型：expectedRevision 必填（CORE-013 强制乐观锁）。
type (
	UpdatePostV2Req {
		PostId           int64    `path:"postId"`
		Title            string   `json:"title,optional"`
		Content          string   `json:"content,optional"`
		Images           []string `json:"images,optional"`
		Tags             []string `json:"tags,optional"`
		Status           *int32   `json:"status,optional"`
		ExpectedRevision int64    `json:"expectedRevision"` // 必填；缺失/0 → 参数错误
		MediaIds         []int64  `json:"mediaIds,optional"`
	}
	DeletePostV2Req {
		PostId           int64 `path:"postId"`
		ExpectedRevision int64 `json:"expectedRevision"` // 必填；缺失/0 → 参数错误
	}
)

type (
	GetPostListReq {
		PageSize int32  `form:"pageSize,default=20"`
		SortBy   int32  `form:"sortBy,default=1"` // 1:最新 2:热门 3:推荐
		Cursor   string `form:"cursor,optional"` // 不透明游标；首页传空
	}
	PostItem {
		Id            int64    `json:"id"`
		AuthorId      int64    `json:"authorId"`
		AuthorName    string   `json:"authorName"`
		AuthorAvatar  string   `json:"authorAvatar"`
		Title         string   `json:"title"`
		Content       string   `json:"content"`
		Images        []string `json:"images"`
		Tags          []string `json:"tags"`
		Status        int32    `json:"status"`
		ViewCount     int64    `json:"viewCount"`
		LikeCount     int64    `json:"likeCount"`
		CommentCount  int64    `json:"commentCount"`
		FavoriteCount int64    `json:"favoriteCount"`
		IsLiked       bool     `json:"isLiked"`
		IsFavorited   bool     `json:"isFavorited"`
		Revision      int64    `json:"revision"`
		CreatedAt     int64    `json:"createdAt"`
	}
	GetPostListResp {
		List       []PostItem `json:"list"`
		NextCursor string     `json:"nextCursor"` // 为空表示没有更多
	}
)

// ============================================
// 评论相关类型
// ============================================
type (
	CreateCommentReq {
		PostId         int64  `json:"postId"`
		ParentId       int64  `json:"parentId,optional"`
		ReplyUserId    int64  `json:"replyUserId,optional"`
		Content        string `json:"content"`
		IdempotencyKey string `json:"idempotencyKey,optional"`
	}
	CreateCommentResp {
		CommentId int64 `json:"commentId"`
	}
)

type (
	DeleteCommentReq {
		CommentId int64 `path:"commentId"`
	}
	DeleteCommentResp  {}
)

type (
	GetCommentListReq {
		PostId   int64 `path:"postId"`
		Page     int32 `form:"page,default=1"`
		PageSize int32 `form:"pageSize,default=20"`
		SortBy   int32 `form:"sortBy,default=1"` // 1:最新 2:最热
	}
	CommentItem {
		Id          int64         `json:"id"`
		UserId      int64         `json:"userId"`
		UserName    string        `json:"userName"`
		UserAvatar  string        `json:"userAvatar"`
		ParentId    int64         `json:"parentId"`
		ReplyUserId int64         `json:"replyUserId"`
		Content     string        `json:"content"`
		LikeCount   int64         `json:"likeCount"`
		CreatedAt   int64         `json:"createdAt"`
		ReplyCount  int64         `json:"replyCount"` // 楼中楼回复总数，仅顶级评论有值
		Replies     []CommentItem `json:"replies"` // 内嵌回复预览（前 N 条），仅顶级评论有值
	}
	GetCommentListResp {
		List     []CommentItem `json:"list"`
		Total    int64         `json:"total"`
		Page     int32         `json:"page"`
		PageSize int32         `json:"pageSize"`
	}
	GetCommentRepliesReq {
		CommentId int64 `path:"commentId"`
		Page      int32 `form:"page,default=1"`
		PageSize  int32 `form:"pageSize,default=20"`
	}
	GetCommentRepliesResp {
		List     []CommentItem `json:"list"`
		Total    int64         `json:"total"`
		Page     int32         `json:"page"`
		PageSize int32         `json:"pageSize"`
	}
)

// ============================================
// 互动相关类型
// ============================================
type (
	LikeReq {
		TargetId   int64 `json:"targetId"`
		TargetType int32 `json:"targetType"` // 1:帖子 2:评论
	}
	LikeResp  {}
)

type (
	UnlikeReq {
		TargetId   int64 `json:"targetId"`
		TargetType int32 `json:"targetType"`
	}
	UnlikeResp  {}
)

type (
	FavoriteReq {
		PostId int64 `json:"postId"`
	}
	FavoriteResp  {}
)

type (
	UnfavoriteReq {
		PostId int64 `json:"postId"`
	}
	UnfavoriteResp  {}
)

type (
	FollowReq {
		TargetUserId int64 `json:"targetUserId"`
	}
	FollowResp  {}
)

type (
	UnfollowReq {
		TargetUserId int64 `json:"targetUserId"`
	}
	UnfollowResp  {}
)

// ============================================
// 媒体相关类型
// ============================================
type (
	UploadImageReq  {}
	UploadImageResp {
		MediaId      int64  `json:"mediaId"`
		Url          string `json:"url"`
		ThumbnailUrl string `json:"thumbnailUrl"`
	}
)

// ============================================
// v2 行为、Feed、搜索、消息和 Assistant 类型
// ============================================
type (
	BehaviorEvent {
		ClientEventId string `json:"clientEventId"`
		OccurredAt    int64  `json:"occurredAt"`
		Action        string `json:"action"`
		TargetId      int64  `json:"targetId"`
		TargetType    string `json:"targetType"`
		Scene         string `json:"scene,optional"`
		RequestId     string `json:"requestId,optional"`
		Position      *int32 `json:"position,optional"`
		DurationMs    *int64 `json:"durationMs,optional"`
		RecallSource  string `json:"recallSource,optional"`
		ModelVersion  string `json:"modelVersion,optional"`
		ExperimentId  string `json:"experimentId,optional"`
	}
	RecordBehaviorEventsReq {
		AnonymousId string          `json:"anonymousId,optional"`
		SessionId   string          `json:"sessionId,optional"`
		Events      []BehaviorEvent `json:"events"`
	}
	BehaviorEventResult {
		ClientEventId string `json:"clientEventId"`
		EventId       int64  `json:"eventId"`
		Accepted      bool   `json:"accepted"`
		Code          int32  `json:"code"`
		Reason        string `json:"reason"`
	}
	RecordBehaviorEventsResp {
		Results       []BehaviorEventResult `json:"results"`
		AcceptedCount int32                 `json:"acceptedCount"`
		RejectedCount int32                 `json:"rejectedCount"`
	}
)

type (
	FeedItem {
		PostId        int64    `json:"postId"`
		AuthorId      int64    `json:"authorId"`
		AuthorName    string   `json:"authorName"`
		AuthorAvatar  string   `json:"authorAvatar"`
		CreatedAt     int64    `json:"createdAt"`
		FeedType      int32    `json:"feedType"`
		Title         string   `json:"title"`
		Content       string   `json:"content"`
		Images        []string `json:"images"`
		Tags          []string `json:"tags"`
		ViewCount     int64    `json:"viewCount"`
		LikeCount     int64    `json:"likeCount"`
		CommentCount  int64    `json:"commentCount"`
		FavoriteCount int64    `json:"favoriteCount"`
		IsLiked       bool     `json:"isLiked"`
	}
	GetFollowFeedReq {
		CursorCreatedAt int64 `form:"cursorCreatedAt,optional"`
		CursorPostId    int64 `form:"cursorPostId,optional"`
		PageSize        int32 `form:"pageSize,default=20"`
	}
	GetFollowFeedResp {
		Items               []FeedItem `json:"items"`
		HasMore             bool       `json:"hasMore"`
		NextCursorCreatedAt int64      `json:"nextCursorCreatedAt"`
		NextCursorPostId    int64      `json:"nextCursorPostId"`
	}
)

type (
	GetRecommendFeedReq {
		AnonymousId  string `form:"anonymousId,optional"`
		Scene        string `form:"scene,default=home"`
		RequestId    string `form:"requestId"`
		SessionId    string `form:"sessionId,optional"`
		Cursor       string `form:"cursor,optional"`
		PageSize     int32  `form:"pageSize,default=20"`
		ExperimentId string `form:"experimentId,optional"`
	}
	RecommendFeedItem {
		PostId        int64    `json:"postId"`
		AuthorId      int64    `json:"authorId"`
		AuthorName    string   `json:"authorName"`
		AuthorAvatar  string   `json:"authorAvatar"`
		CreatedAt     int64    `json:"createdAt"`
		FeedType      int32    `json:"feedType"`
		Title         string   `json:"title"`
		Content       string   `json:"content"`
		Images        []string `json:"images"`
		Tags          []string `json:"tags"`
		ViewCount     int64    `json:"viewCount"`
		LikeCount     int64    `json:"likeCount"`
		CommentCount  int64    `json:"commentCount"`
		FavoriteCount int64    `json:"favoriteCount"`
		IsLiked       bool     `json:"isLiked"`
		Score         float64  `json:"score"`
		Reason        string   `json:"reason"`
		RecallSource  string   `json:"recallSource"`
		ModelVersion  string   `json:"modelVersion"`
		ExperimentId  string   `json:"experimentId"`
		Position      int32    `json:"position"`
	}
	GetRecommendFeedResp {
		Items      []RecommendFeedItem `json:"items"`
		NextCursor string              `json:"nextCursor"`
		HasMore    bool                `json:"hasMore"`
		RequestId  string              `json:"requestId"`
	}
)

type (
	SearchReq {
		Keyword  string `form:"keyword"`
		Page     int32  `form:"page,default=1"`
		PageSize int32  `form:"pageSize,default=20"`
	}
	SearchPostItem {
		Id               int64  `json:"id"`
		Title            string `json:"title"`
		ContentHighlight string `json:"contentHighlight"`
		AuthorId         int64  `json:"authorId"`
		AuthorName       string `json:"authorName"`
		AuthorAvatar     string `json:"authorAvatar"`
		LikeCount        int64  `json:"likeCount"`
		CommentCount     int64  `json:"commentCount"`
		CreatedAt        int64  `json:"createdAt"`
	}
	SearchUserItem {
		Id            int64  `json:"id"`
		Username      string `json:"username"`
		Nickname      string `json:"nickname"`
		AvatarUrl     string `json:"avatarUrl"`
		Bio           string `json:"bio"`
		FollowerCount int64  `json:"followerCount"`
	}
	SearchTagItem {
		Name      string `json:"name"`
		PostCount int64  `json:"postCount"`
	}
	SearchResp {
		Posts            []SearchPostItem `json:"posts"`
		Users            []SearchUserItem `json:"users"`
		Tags             []SearchTagItem  `json:"tags"`
		Degraded         bool             `json:"degraded"`
		UnavailableTypes []string         `json:"unavailableTypes,optional"`
	}
)

type (
	SearchUsersReq {
		Keyword  string `form:"keyword"`
		Page     int32  `form:"page,default=1"`
		PageSize int32  `form:"pageSize,default=20"`
	}
	SearchUsersResp {
		Users []SearchUserItem `json:"users"`
		Total int64            `json:"total"`
	}
	SearchTagsReq {
		Keyword string `form:"keyword"`
		Limit   int32  `form:"limit,default=20"`
	}
	SearchTagsResp {
		Tags []SearchTagItem `json:"tags"`
	}
)

type (
	GetConversationsReq {
		Page     int32 `form:"page,default=1"`
		PageSize int32 `form:"pageSize,default=20"`
	}
	ConversationItem {
		Id               int64  `json:"id"`
		TargetUserId     int64  `json:"targetUserId"`
		TargetUserName   string `json:"targetUserName"`
		TargetUserAvatar string `json:"targetUserAvatar"`
		LastMessage      string `json:"lastMessage"`
		LastMessageTime  int64  `json:"lastMessageTime"`
		UnreadCount      int32  `json:"unreadCount"`
	}
	GetConversationsResp {
		Conversations []ConversationItem `json:"conversations"`
		Total         int64              `json:"total"`
	}
)

type (
	GetMessagesReq {
		ConversationId int64 `path:"id"`
		LastId         int64 `form:"lastId,optional"`
		PageSize       int32 `form:"pageSize,default=20"`
	}
	MessageItem {
		Id             int64  `json:"id"`
		ConversationId int64  `json:"conversationId"`
		SenderId       int64  `json:"senderId"`
		ReceiverId     int64  `json:"receiverId"`
		Content        string `json:"content"`
		MsgType        int32  `json:"msgType"`
		Status         int32  `json:"status"`
		CreatedAt      int64  `json:"createdAt"`
	}
	GetMessagesResp {
		Messages []MessageItem `json:"messages"`
		HasMore  bool          `json:"hasMore"`
	}
	SendMessageReq {
		ReceiverId     int64  `json:"receiverId"`
		Content        string `json:"content"`
		MsgType        int32  `json:"msgType"`
		IdempotencyKey string `json:"idempotencyKey"`
		MediaId        int64  `json:"mediaId,optional"`
	}
	SendMessageResp {
		MessageId int64 `json:"messageId"`
	}
	MarkConversationReadReq {
		ConversationId int64 `path:"id"`
	}
	MarkConversationReadResp  {}
	GetUnreadSummaryResp {
		MessageUnread      int32 `json:"messageUnread"`
		NotificationUnread int32 `json:"notificationUnread"`
	}
)

type (
	GetPersonalizationPreferenceResp {
		Enabled    bool  `json:"enabled"`
		OptedOutAt int64 `json:"optedOutAt"`
	}
	SetPersonalizationPreferenceReq {
		Enabled bool `json:"enabled"`
	}
	SetPersonalizationPreferenceResp  {}
)

type (
	GetAgentConsentResp {
		Granted        bool  `json:"granted"`
		GrantedAt      int64 `json:"grantedAt,optional"`
		RevokedAt      int64 `json:"revokedAt,optional"`
		ConsentVersion int32 `json:"consentVersion"`
		CurrentVersion int32 `json:"currentVersion"`
	}
	SetAgentConsentReq {
		Granted bool `json:"granted"`
	}
	SetAgentConsentResp  {}
	AssistantAttachment {
		MediaId int64  `json:"mediaId"`
		Url     string `json:"url"`
	}
	AssistantThread {
		SessionId          int64  `json:"sessionId"`
		UnreadCount        int32  `json:"unreadCount"`
		LastMessageId      int64  `json:"lastMessageId"`
		LastMessagePreview string `json:"lastMessagePreview"`
		LastMessageAtMs    int64  `json:"lastMessageAtMs"`
		ActiveRunId        int64  `json:"activeRunId"`
		ActiveRunStatus    string `json:"activeRunStatus,optional"`
		ActiveRunPhase     string `json:"activeRunPhase,optional"`
	}
	GetAssistantThreadResp {
		Thread AssistantThread `json:"thread"`
	}
	ListAssistantMessagesReq {
		SessionId int64 `form:"sessionId,optional"`
		AfterId   int64 `form:"afterId,optional"`
		BeforeId  int64 `form:"beforeId,optional"`
		Limit     int32 `form:"limit,optional"`
	}
	AssistantMessage {
		Id          int64  `json:"id"`
		SessionId   int64  `json:"sessionId"`
		RunId       int64  `json:"runId"`
		Role        string `json:"role"`
		Kind        string `json:"kind"`
		Content     string `json:"content"`
		Unread      bool   `json:"unread"`
		CreatedAtMs int64  `json:"createdAtMs"`
		ChangeId    int64  `json:"changeId,optional"`
	}
	ListAssistantMessagesResp {
		Messages     []AssistantMessage `json:"messages"`
		HasMore      bool               `json:"hasMore"`
		NextBeforeId int64              `json:"nextBeforeId,optional"`
	}
	PostAssistantMessageReq {
		Message       string                `json:"message"`
		RequestId     string                `json:"requestId,optional"`
		Attachments   []AssistantAttachment `json:"attachments,optional"`
		ContextPostId int64                 `json:"contextPostId,optional"`
	}
	PostAssistantMessageResp {
		MessageId   int64  `json:"messageId"`
		SessionId   int64  `json:"sessionId"`
		RunId       int64  `json:"runId"`
		Disposition string `json:"disposition"`
	}
	CreateAssistantSessionResp {
		SessionId int64 `json:"sessionId"`
	}
	MarkAssistantThreadReadResp {
		UnreadCount int32 `json:"unreadCount"`
	}
	DeleteAssistantHistoryResp  {}
	AssistantRunEventsReq {
		Id       int64 `path:"id"`
		AfterSeq int64 `form:"afterSeq,optional"`
	}
	AssistantToolCallInfo {
		CallId      string `json:"callId"`
		Tool        string `json:"tool"`
		Summary     string `json:"summary"`
		PayloadJson string `json:"payloadJson,optional"`
	}
	AssistantSourceCard {
		Handle      string `json:"handle"`
		Kind        string `json:"kind"`
		AuthorityId string `json:"authorityId"`
		Title       string `json:"title"`
		Revision    int64  `json:"revision"`
		PayloadJson string `json:"payloadJson,optional"`
	}
	AssistantRunEvent {
		RunId      int64                  `json:"runId"`
		Seq        int64                  `json:"seq"`
		Type       string                 `json:"type"`
		Text       string                 `json:"text,optional"`
		Degraded   bool                   `json:"degraded,optional"`
		ErrorCode  string                 `json:"errorCode,optional"`
		SessionId  int64                  `json:"sessionId"`
		ToolCall   *AssistantToolCallInfo `json:"toolCall,optional"`
		SourceCard *AssistantSourceCard   `json:"sourceCard,optional"`
		ChangeId   int64                  `json:"changeId,optional"`
	}
	CancelAssistantRunReq {
		Id int64 `path:"id"`
	}
	CancelAssistantRunResp  {}
	ConfirmAssistantRunReq {
		Id       int64  `path:"id"`
		CallId   string `json:"callId"`
		Approved bool   `json:"approved"`
	}
	ConfirmAssistantRunResp  {}
	AssistantMemoryEntry {
		Id          int64  `json:"id"`
		Target      string `json:"target"`
		Content     string `json:"content"`
		Version     int32  `json:"version"`
		CreatedAtMs int64  `json:"createdAtMs"`
		UpdatedAtMs int64  `json:"updatedAtMs"`
	}
	AssistantMemoryCapacity {
		Target string `json:"target"`
		Used   int32  `json:"used"`
		Limit  int32  `json:"limit"`
	}
	ListAssistantMemoryReq {
		Target string `form:"target,optional"`
	}
	ListAssistantMemoryResp {
		Items      []AssistantMemoryEntry    `json:"items"`
		Capacities []AssistantMemoryCapacity `json:"capacities"`
	}
	AddAssistantMemoryReq {
		Target    string `json:"target"`
		Content   string `json:"content"`
		RequestId string `json:"requestId,optional"`
	}
	AddAssistantMemoryResp {
		Entry    AssistantMemoryEntry `json:"entry"`
		ChangeId int64                `json:"changeId"`
	}
	ReplaceAssistantMemoryReq {
		Id        int64  `path:"id"`
		Content   string `json:"content"`
		Version   int32  `json:"version"`
		RequestId string `json:"requestId,optional"`
	}
	ReplaceAssistantMemoryResp {
		Entry    AssistantMemoryEntry `json:"entry"`
		ChangeId int64                `json:"changeId"`
	}
	RemoveAssistantMemoryReq {
		Id        int64  `path:"id"`
		Version   int32  `form:"version"`
		RequestId string `form:"requestId,optional"`
	}
	RemoveAssistantMemoryResp {
		ChangeId int64 `json:"changeId"`
	}
	AssistantMemoryOp {
		Op      string `json:"op"`
		Id      int64  `json:"id,optional"`
		Target  string `json:"target,optional"`
		Content string `json:"content,optional"`
		Version int32  `json:"version,optional"`
	}
	BatchAssistantMemoryReq {
		RequestId string              `json:"requestId,optional"`
		Ops       []AssistantMemoryOp `json:"ops"`
	}
	BatchAssistantMemoryResp {
		Entries   []AssistantMemoryEntry `json:"entries"`
		ChangeIds []int64                `json:"changeIds"`
	}
	UndoAssistantMemoryChangeReq {
		Id int64 `path:"id"`
	}
	UndoAssistantMemoryChangeResp {
		Entry AssistantMemoryEntry `json:"entry"`
	}
	AssistantWatchTask {
		Id            int64  `json:"id"`
		ConditionType string `json:"conditionType"`
		TargetType    string `json:"targetType"`
		TargetId      int64  `json:"targetId"`
		TargetText    string `json:"targetText"`
		Enabled       bool   `json:"enabled"`
		Version       int32  `json:"version"`
		CreatedAt     int64  `json:"createdAt"`
	}
	ListAssistantWatchReq  {}
	ListAssistantWatchResp {
		Tasks []AssistantWatchTask `json:"tasks"`
	}
	CreateAssistantWatchReq {
		ConditionType string `json:"conditionType"`
		TargetType    string `json:"targetType"`
		TargetId      int64  `json:"targetId,optional"`
		TargetText    string `json:"targetText,optional"`
	}
	CreateAssistantWatchResp {
		Task AssistantWatchTask `json:"task"`
	}
	UpdateAssistantWatchReq {
		Id      int64 `path:"id"`
		Enabled bool  `json:"enabled"`
	}
	UpdateAssistantWatchResp  {}
	DeleteAssistantWatchReq {
		Id int64 `path:"id"`
	}
	DeleteAssistantWatchResp  {}
	AssistantRecommendFeedbackReq {
		RequestId string `json:"requestId,optional"`
		PostId    int64  `json:"postId"`
		Reason    string `json:"reason"`
	}
	AssistantRecommendFeedbackResp  {}
)

// ============================================
// 健康检查
// ============================================
type (
	HealthReq  {}
	HealthResp {
		Status string `json:"status"`
	}
	HealthReadyResp {
		Status       string            `json:"status"` // ready | degraded | unavailable
		Dependencies map[string]string `json:"dependencies"` // name -> ok | down
	}
)

// ============================================
// 路由定义
// ============================================
@server (
	prefix: /api/v1
)
service gateway {
	@doc "健康检查"
	@handler Health
	get /health (HealthReq) returns (HealthResp)

	@doc "就绪检查"
	@handler HealthReady
	get /health/ready (HealthReq) returns (HealthReadyResp)
}

@server (
	prefix:     /api/v1
	group:      posts
	middleware: OptionalAuth
)
service gateway {
	@doc "获取帖子列表"
	@handler GetPostList
	get /posts (GetPostListReq) returns (GetPostListResp)

	@doc "获取帖子详情"
	@handler GetPost
	get /post/:postId (GetPostReq) returns (GetPostResp)
}

@server (
	prefix: /api/v1
	group:  login
)
service gateway {
	@doc "用户注册"
	@handler Register
	post /auth/register (RegisterReq) returns (RegisterResp)

	@doc "用户登录"
	@handler Login
	post /auth/login (LoginReq) returns (LoginResp)

	@doc "发送验证码"
	@handler SendVerifyCode
	post /auth/verify-code (SendVerifyCodeReq) returns (SendVerifyCodeResp)

	@doc "刷新令牌：凭 refresh token 换取全新令牌对"
	@handler RefreshToken
	post /auth/refresh (RefreshTokenReq) returns (RefreshTokenResp)
}

@server (
	prefix:     /api/v1
	group:      user
	middleware: OptionalAuth
)
service gateway {
	@doc "获取用户信息"
	@handler GetUser
	get /user/:userId (GetUserReq) returns (GetUserResp)

	@doc "获取用户发布的帖子列表"
	@handler GetUserPosts
	get /users/:userId/posts (GetUserPostsReq) returns (GetPostListResp)

	@doc "获取用户的收藏帖子列表"
	@handler GetUserFavorites
	get /users/:userId/favorites (GetUserFavoritesReq) returns (GetPostListResp)
}

@server (
	prefix:     /api/v1
	group:      user
	middleware: RequiredAuth
)
service gateway {
	@doc "更新用户资料"
	@handler UpdateProfile
	put /user/profile (UpdateProfileReq) returns (UpdateProfileResp)

	@doc "关注用户"
	@handler Follow
	post /user/follow (FollowReq) returns (FollowResp)

	@doc "取消关注"
	@handler Unfollow
	delete /user/follow (UnfollowReq) returns (UnfollowResp)
}

@server (
	prefix:     /api/v2
	group:      posts
	middleware: RequiredAuth
)
service gateway {
	// CORE-013：v2 写接口强制乐观锁，Update/Delete 必须携带 expectedRevision，
	// 缺失或为 0 时按参数错误拒绝；版本冲突返回 409。
	@doc "创建帖子（v2）"
	@handler CreatePostV2
	post /post (CreatePostReq) returns (CreatePostResp)

	@doc "更新帖子（v2，强制 expectedRevision）"
	@handler UpdatePostV2
	put /post/:postId (UpdatePostV2Req) returns (UpdatePostResp)

	@doc "删除帖子（v2，强制 expectedRevision）"
	@handler DeletePostV2
	delete /post/:postId (DeletePostV2Req) returns (DeletePostResp)
}

@server (
	prefix:     /api/v1
	group:      comment
	middleware: OptionalAuth
)
service gateway {
	@doc "获取评论列表"
	@handler GetCommentList
	get /comments/:postId (GetCommentListReq) returns (GetCommentListResp)

	@doc "获取评论的回复列表（楼中楼分页，时间正序）"
	@handler GetCommentReplies
	get /comments/:commentId/replies (GetCommentRepliesReq) returns (GetCommentRepliesResp)
}

@server (
	prefix:     /api/v1
	group:      comment
	middleware: RequiredAuth
)
service gateway {
	@doc "创建评论"
	@handler CreateComment
	post /comment (CreateCommentReq) returns (CreateCommentResp)

	@doc "删除评论"
	@handler DeleteComment
	delete /comment/:commentId (DeleteCommentReq) returns (DeleteCommentResp)
}

@server (
	prefix:     /api/v1
	group:      like_favorite
	middleware: RequiredAuth
)
service gateway {
	@doc "点赞"
	@handler Like
	post /like (LikeReq) returns (LikeResp)

	@doc "取消点赞"
	@handler Unlike
	delete /like (UnlikeReq) returns (UnlikeResp)

	@doc "收藏"
	@handler Favorite
	post /favorite (FavoriteReq) returns (FavoriteResp)

	@doc "取消收藏"
	@handler Unfavorite
	delete /favorite (UnfavoriteReq) returns (UnfavoriteResp)
}

@server (
	prefix:     /api/v1
	group:      image
	middleware: RequiredAuth
)
service gateway {
	@doc "上传图片"
	@handler UploadImage
	post /media/image (UploadImageReq) returns (UploadImageResp)
}

@server (
	prefix:     /api/v2
	group:      behavior
	middleware: OptionalAuth,BehaviorAccepted
)
service gateway {
	@doc "批量记录客户端行为"
	@handler RecordBehaviorEvents
	post /behavior/events (RecordBehaviorEventsReq) returns (RecordBehaviorEventsResp)
}

@server (
	prefix:     /api/v2
	group:      feed
	middleware: RequiredAuth
)
service gateway {
	@doc "获取关注流"
	@handler GetFollowFeed
	get /feed/follow (GetFollowFeedReq) returns (GetFollowFeedResp)
}

@server (
	prefix:     /api/v2
	group:      feed
	middleware: OptionalAuth
)
service gateway {
	@doc "获取推荐流"
	@handler GetRecommendFeed
	get /feed/recommend (GetRecommendFeedReq) returns (GetRecommendFeedResp)
}

@server (
	prefix: /api/v2
	group:  search
)
service gateway {
	@doc "综合搜索"
	@handler Search
	get /search (SearchReq) returns (SearchResp)

	@doc "搜索用户"
	@handler SearchUsers
	get /search/users (SearchUsersReq) returns (SearchUsersResp)

	@doc "搜索标签"
	@handler SearchTags
	get /search/tags (SearchTagsReq) returns (SearchTagsResp)
}

@server (
	prefix:     /api/v2
	group:      message
	middleware: RequiredAuth
)
service gateway {
	@doc "获取会话列表"
	@handler GetConversations
	get /messages/conversations (GetConversationsReq) returns (GetConversationsResp)

	@doc "获取会话消息"
	@handler GetMessages
	get /messages/conversations/:id (GetMessagesReq) returns (GetMessagesResp)

	@doc "发送私信"
	@handler SendMessage
	post /messages (SendMessageReq) returns (SendMessageResp)

	@doc "标记会话已读"
	@handler MarkConversationRead
	post /messages/conversations/:id/read (MarkConversationReadReq) returns (MarkConversationReadResp)

	@doc "获取未读汇总"
	@handler GetUnreadSummary
	get /messages/unread returns (GetUnreadSummaryResp)
}

@server (
	prefix:     /api/v2
	group:      assistant
	middleware: RequiredAuth
	sse:        true
)
service gateway {
	@doc "Assistant run SSE 事件"
	@handler AssistantRunEvents
	get /assistant/runs/:id/events (AssistantRunEventsReq) returns (AssistantRunEvent)
}

@server (
	prefix:     /api/v2
	group:      assistant
	middleware: RequiredAuth
)
service gateway {
	@doc "查询 Agent 能力授权状态"
	@handler GetAgentConsent
	get /assistant/consent returns (GetAgentConsentResp)

	@doc "记录或撤销 Agent 能力授权"
	@handler SetAgentConsent
	post /assistant/consent (SetAgentConsentReq) returns (SetAgentConsentResp)

	@doc "虚拟线程摘要"
	@handler GetAssistantThread
	get /assistant/thread returns (GetAssistantThreadResp)

	@doc "列出 Assistant 消息"
	@handler ListAssistantMessages
	get /assistant/messages (ListAssistantMessagesReq) returns (ListAssistantMessagesResp)

	@doc "发送 Assistant 消息并接受异步 run"
	@handler PostAssistantMessage
	post /assistant/messages (PostAssistantMessageReq) returns (PostAssistantMessageResp)

	@doc "开始新会话"
	@handler CreateAssistantSession
	post /assistant/sessions returns (CreateAssistantSessionResp)

	@doc "标记 Assistant 线程已读"
	@handler MarkAssistantThreadRead
	post /assistant/thread/read returns (MarkAssistantThreadReadResp)

	@doc "清除 Assistant 历史"
	@handler DeleteAssistantHistory
	delete /assistant/history returns (DeleteAssistantHistoryResp)

	@doc "取消 Assistant run"
	@handler CancelAssistantRun
	post /assistant/runs/:id/cancel (CancelAssistantRunReq) returns (CancelAssistantRunResp)

	@doc "确认或拒绝 delete_post"
	@handler ConfirmAssistantRun
	post /assistant/runs/:id/confirm (ConfirmAssistantRunReq) returns (ConfirmAssistantRunResp)

	@doc "列出 MEMORY/USER 条目"
	@handler ListAssistantMemory
	get /assistant/memory (ListAssistantMemoryReq) returns (ListAssistantMemoryResp)

	@doc "新增记忆条目"
	@handler AddAssistantMemory
	post /assistant/memory (AddAssistantMemoryReq) returns (AddAssistantMemoryResp)

	@doc "替换记忆条目"
	@handler ReplaceAssistantMemory
	patch /assistant/memory/:id (ReplaceAssistantMemoryReq) returns (ReplaceAssistantMemoryResp)

	@doc "删除记忆条目"
	@handler RemoveAssistantMemory
	delete /assistant/memory/:id (RemoveAssistantMemoryReq) returns (RemoveAssistantMemoryResp)

	@doc "批量记忆写入"
	@handler BatchAssistantMemory
	post /assistant/memory/batch (BatchAssistantMemoryReq) returns (BatchAssistantMemoryResp)

	@doc "撤销一次记忆变更"
	@handler UndoAssistantMemoryChange
	post /assistant/memory/changes/:id/undo (UndoAssistantMemoryChangeReq) returns (UndoAssistantMemoryChangeResp)

	@doc "列出 Watch 任务"
	@handler ListAssistantWatch
	get /assistant/watch (ListAssistantWatchReq) returns (ListAssistantWatchResp)

	@doc "创建 Watch 任务"
	@handler CreateAssistantWatch
	post /assistant/watch (CreateAssistantWatchReq) returns (CreateAssistantWatchResp)

	@doc "更新 Watch 任务"
	@handler UpdateAssistantWatch
	patch /assistant/watch/:id (UpdateAssistantWatchReq) returns (UpdateAssistantWatchResp)

	@doc "删除 Watch 任务"
	@handler DeleteAssistantWatch
	delete /assistant/watch/:id (DeleteAssistantWatchReq) returns (DeleteAssistantWatchResp)

	@doc "提交 Agent 推荐反馈"
	@handler SubmitAssistantRecommendFeedback
	post /assistant/recommend/feedback (AssistantRecommendFeedbackReq) returns (AssistantRecommendFeedbackResp)
}

@server (
	prefix:     /api/v2
	group:      user
	middleware: RequiredAuth
)
service gateway {
	@doc "获取个性化偏好"
	@handler GetPersonalizationPreference
	get /me/personalization returns (GetPersonalizationPreferenceResp)

	@doc "设置个性化偏好"
	@handler SetPersonalizationPreference
	put /me/personalization (SetPersonalizationPreferenceReq) returns (SetPersonalizationPreferenceResp)
}

